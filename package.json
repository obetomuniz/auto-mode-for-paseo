{
  "name": "auto-mode-for-paseo",
  "private": true,
  "version": "0.2.0",
  "description": "Route Paseo messages to configurable presets and providers with Jev, local Laya, or the OpenAI Decisions API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obetomuniz/auto-mode-for-paseo.git"
  },
  "homepage": "https://github.com/obetomuniz/auto-mode-for-paseo#readme",
  "bugs": {
    "url": "https://github.com/obetomuniz/auto-mode-for-paseo/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "paseo",
    "jev",
    "codex",
    "claude-code",
    "opencode",
    "typesafe",
    "model-router",
    "system1",
    "system-one",
    "laya"
  ],
  "scripts": {
    "paseo": "scripts\\paseo.cmd",
    "plugin:install": "npm run paseo -- plugin install \"%CD%\"",
    "plugin:reload": "npm run paseo -- plugin reload auto-mode-for-paseo",
    "plugin:status": "npm run paseo -- plugin ls --json",
    "laya:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-laya.ps1",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "pretest": "node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\"",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.8.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.5.2",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
